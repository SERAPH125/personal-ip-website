---
import { withBase } from "../lib/site";

interface Props {
  active?: "home" | "works" | "learn" | "notes" | "about";
}

const { active } = Astro.props;
const items = [
  { key: "home", label: "首页", href: "index.html" },
  { key: "works", label: "作品", href: "works.html" },
  { key: "learn", label: "学习路线", href: "learn.html" },
  { key: "notes", label: "知识库", href: "notes.html" },
  { key: "about", label: "关于", href: "about.html" },
] as const;
---

<header class="site-nav" data-od-id="site-nav">
  <div class="site-nav__inner">
    <a class="brand" data-od-id="brand" href={withBase("index.html")}>南吴<span>NANWU</span></a>
    <button
      class="nav-toggle"
      type="button"
      data-od-id="nav-toggle"
      aria-label="打开菜单"
      aria-expanded="false"
      aria-controls="nav-links"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
    <nav class="nav-links" id="nav-links" data-od-id="nav-links" aria-label="主导航">
      {items.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={{ "is-active": active === item.key }}
          aria-current={active === item.key ? "page" : undefined}
        >{item.label}</a>
      ))}
    </nav>
  </div>
</header>
