---
import { getCollection } from "astro:content";
import ToolCard from "../components/ToolCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  absoluteUrl,
  toolCategoryMeta,
  toolUrl,
} from "../lib/site";

const tools = (await getCollection("tools", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.sequence - b.data.sequence,
);
const directoryGroups = Object.entries(toolCategoryMeta).map(([key, meta]) => ({
  key,
  meta,
  entries: tools.filter((entry) => entry.data.category === key),
}));
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "AI 工具指南 · 南吴 NANWU",
  url: absoluteUrl("tools.html"),
  description: "面向普通读者的 AI 工具安装、首次使用、排错、费用、隐私与许可证指南。",
  isPartOf: { "@id": `${absoluteUrl("")}#website` },
  hasPart: tools.map((entry) => ({
    "@type": "TechArticle",
    name: entry.data.title,
    url: toolUrl(entry.id),
  })),
};
---

<BaseLayout
  title="AI 工具指南"
  description="20 款 AI 工具的图文安装与使用指南，覆盖语言模型与客户端、图像生成、AI 编程和视频生成与剪辑。"
  canonicalPath="tools.html"
  activeNav="tools"
  structuredData={schema}
  mainId="tools-page"
>
  <main class="page page--tools" id="tools-page" data-od-id="tools-page" tabindex="-1">
    <section class="tools-shell" aria-label="AI 工具目录">
      <aside class="tools-sidebar" data-tool-sidebar aria-label="工具目录侧栏">
        <div class="tools-sidebar__sticky">
          <div class="tools-sidebar__intro">
            <p class="eyebrow eyebrow--muted">Tool Directory</p>
            <h2>工具目录</h2>
            <p>{directoryGroups.length} 个类别 · {tools.length} 款工具</p>
          </div>

          <details class="tool-directory-disclosure" data-tool-directory-disclosure open>
            <summary>
              <span>工具目录</span>
              <small>{directoryGroups.length} 类 · {tools.length} 款</small>
            </summary>
            <nav class="tool-directory" aria-label="按类别浏览工具">
              {directoryGroups.map((group) => (
                <div class="tool-directory__group" data-tool-directory-nav-group={group.key}>
                  <a class="tool-directory__category" href={`#category-${group.key}`}>
                    <span>{group.meta.label}</span>
                    <small>{group.entries.length}</small>
                  </a>
                  <ol>
                    {group.entries.map((entry) => (
                      <li>
                        <a
                          data-tool-directory-link={entry.id}
                          href={`#tool-${entry.id}`}
                        >{entry.data.toolName}</a>
                      </li>
                    ))}
                  </ol>
                </div>
              ))}
            </nav>
          </details>
        </div>
      </aside>

      <div class="tools-content">
        <header class="tools-hero">
          <p class="eyebrow eyebrow--muted">Install · First run · Troubleshoot</p>
          <h1>AI 工具指南</h1>
          <p class="lede">从官方入口、安装和第一次使用讲起，也把费用、隐私、开源状态与常见故障说清楚。</p>
          <p class="tools-count">当前收录 <strong>{tools.length}</strong> 款 AI 工具，包含网页服务、客户端、编辑器、插件与本地工作流；每篇均标注官方资料与核验日期。</p>
        </header>

        {directoryGroups.map((group) => (
          <section
            class="tool-directory-section"
            id={`category-${group.key}`}
            data-tool-directory-section={group.key}
            aria-labelledby={`category-${group.key}-title`}
          >
            <header class="tool-directory-section__head">
              <div>
                <p class="eyebrow">AI Tools</p>
                <h2 id={`category-${group.key}-title`}>{group.meta.label}</h2>
              </div>
              <p>{group.entries.length} 款</p>
            </header>
            <ul class="tool-grid" data-od-id={`tool-grid-${group.key}`}>
              {group.entries.map((entry) => <ToolCard entry={entry} />)}
            </ul>
          </section>
        ))}
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const disclosure = document.querySelector("[data-tool-directory-disclosure]");
      if (!(disclosure instanceof HTMLDetailsElement)) return;

      const desktop = window.matchMedia("(min-width: 821px)");
      const syncDisclosure = () => {
        disclosure.open = desktop.matches;
      };

      syncDisclosure();
      desktop.addEventListener("change", syncDisclosure);
      disclosure.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          if (!desktop.matches) disclosure.open = false;
        });
      });
    })();
  </script>
</BaseLayout>
